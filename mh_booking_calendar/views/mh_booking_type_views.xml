<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- MH Booking Type Tree View -->
        <record id="view_mh_booking_type_tree" model="ir.ui.view">
            <field name="name">mh.booking.type.tree</field>
            <field name="model">mh.booking.type</field>
            <field name="arch" type="xml">
                <list string="Booking Types"
                    decoration-success="active"
                    decoration-muted="not active"
                    multi_edit="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_commercial"/>
                    <field name="color" widget="color_picker"/>
                    <field name="price" sum="Total Price"/>
                    <field name="duration"/>
                    <field name="product_id"/>
                    <field name="booking_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- MH Booking Type Form View -->
        <record id="view_mh_booking_type_form" model="ir.ui.view">
            <field name="name">mh.booking.type.form</field>
            <field name="model">mh.booking.type</field>
            <field name="arch" type="xml">
                <form string="Booking Type">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                            <h3>
                                <field name="code"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Basic Info">
                                <field name="is_commercial"/>
                                <field name="color" widget="color_picker"/>
                                <field name="product_id"/>
                                <field name="active"/>
                            </group>
                            <group string="Pricing &amp; Duration">
                                <field name="price"/>
                                <field name="duration"/>
                                <field name="invoice_policy"/>
                            </group>
                        </group>
                        <group string="Zone Assignment">
                            <field name="zone_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Staff Requirements">
                            <group>
                                <field name="requires_special_certification"/>
                                <field name="certification_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="min_staff_count"/>
                                <field name="max_staff_count"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                        <group string="Checklist Properties">
                            <field name="property_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </group>
                        <group string="Statistics">
                            <field name="booking_count"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- MH Booking Type Search View -->
        <record id="view_mh_booking_type_search" model="ir.ui.view">
            <field name="name">mh.booking.type.search</field>
            <field name="model">mh.booking.type</field>
            <field name="arch" type="xml">
                <search string="Search Booking Types">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="product_id"/>
                    <field name="zone_ids"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Commercial" name="commercial" domain="[('is_commercial', '=', True)]"/>
                    <separator/>
                    <filter string="Requires Certification" name="requires_cert" domain="[('requires_special_certification', '=', True)]"/>
                    <group expand="0" string="Group By" name="group_by">
                        <filter string="Active" name="group_active" domain="[]" context="{'group_by': 'active'}"/>
                        <filter string="Commercial" name="group_commercial" domain="[]" context="{'group_by': 'is_commercial'}"/>
                        <filter string="Zone" name="group_zone" domain="[]" context="{'group_by': 'zone_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- MH Booking Type Pivot View -->
        <record id="view_mh_booking_type_pivot" model="ir.ui.view">
            <field name="name">mh.booking.type.pivot</field>
            <field name="model">mh.booking.type</field>
            <field name="arch" type="xml">
                <pivot string="Booking Type Analysis">
                    <field name="name" type="row"/>
                    <field name="is_commercial" type="col"/>
                    <field name="booking_count" type="measure"/>
                    <field name="price" type="measure"/>
                    <field name="duration" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- MH Booking Type Kanban View -->
        <record id="view_mh_booking_type_kanban" model="ir.ui.view">
            <field name="name">mh.booking.type.kanban</field>
            <field name="model">mh.booking.type</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_card_clickable">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <field name="name"/>
                                    </div>
                                </div>
                                <div class="o_kanban_card_body">
                                    <field name="code"/>
                                    <br/>
                                    <field name="price"/>
                                    <br/>
                                    <field name="booking_count"/> Bookings
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- MH Booking Type Action -->
        <record id="action_mh_booking_type" model="ir.actions.act_window">
            <field name="name">Booking Types</field>
            <field name="res_model">mh.booking.type</field>
            <field name="view_mode">tree,form,kanban,pivot</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Booking Type
                </p>
                <p>Booking types define the services you offer, their duration, pricing, and staff requirements.</p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_mh_booking_type"
            name="Booking Types"
            action="action_mh_booking_type"
            parent="menu_mh_booking_root"
            sequence="10"/>

        <!-- MH Booking Type Property Tree View -->
        <record id="view_mh_booking_type_property_tree" model="ir.ui.view">
            <field name="name">mh.booking.type.property.tree</field>
            <field name="model">mh.booking.type.property</field>
            <field name="arch" type="xml">
                <list string="Booking Type Properties"
                    decoration-success="active"
                    decoration-muted="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="field_type"/>
                    <field name="required"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- MH Booking Type Property Form View -->
        <record id="view_mh_booking_type_property_form" model="ir.ui.view">
            <field name="name">mh.booking.type.property.form</field>
            <field name="model">mh.booking.type.property</field>
            <field name="arch" type="xml">
                <form string="Booking Type Property">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="field_type"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="required"/>
                                <field name="default_value"/>
                            </group>
                        </group>
                        <group string="Options">
                            <field name="placeholder"/>
                            <field name="selection_options"/>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- MH Booking Type Property Action -->
        <record id="action_mh_booking_type_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">mh.booking.type.property</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_mh_booking_type_property"
            name="Properties"
            action="action_mh_booking_type_property"
            parent="menu_mh_booking_type"
            sequence="5"/>
    </data>
</odoo>