<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Employee Form to add Booking fields -->
        <record id="view_employee_form_booking" model="ir.ui.view">
            <field name="name">hr.employee.form.booking</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="before">
                    <page string="Booking Configuration" name="booking_config">
                        <group>
                            <group string="Booking Role">
                                <field name="booking_role"/>
                            </group>
                            <group string="Zone Assignment">
                                <field name="primary_zone_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="zone_ids" widget="many2many_tags" placeholder="Select zones..."/>
                        </group>
                        <group>
                            <group string="Capacity Limits">
                                <field name="max_daily_bookings"/>
                                <field name="max_weekly_bookings"/>
                            </group>
                            <group string="Working Schedule">
                                <field name="working_days"/>
                                <field name="working_hour_start" widget="float_time"/>
                                <field name="working_hour_end" widget="float_time"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Employee Tree - add booking role column -->
        <record id="view_employee_tree_booking" model="ir.ui.view">
            <field name="name">hr.employee.list.booking</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <field name="department_id" position="after">
                    <field name="booking_role" optional="show"/>
                    <field name="primary_zone_id" optional="show"/>
                </field>
            </field>
        </record>

        <!-- Employee Search - add booking filters -->
        <record id="view_employee_search_booking" model="ir.ui.view">
            <field name="name">hr.employee.search.booking</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.employee.search"/>
            <field name="arch" type="xml">
                <filter name="inactive" position="after">
                    <separator/>
                    <filter string="Cleaners" name="cleaners" domain="[('booking_role', '=', 'cleaner')]"/>
                    <filter string="Technicians" name="technicians" domain="[('booking_role', '=', 'technician')]"/>
                    <filter string="Drivers" name="drivers" domain="[('booking_role', '=', 'driver')]"/>
                    <separator/>
                    <filter string="Has Primary Zone" name="has_zone" domain="[('primary_zone_id', '!=', False)]"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>