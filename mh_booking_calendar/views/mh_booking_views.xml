<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- MH Booking Tree View -->
        <record id="view_mh_booking_tree" model="ir.ui.view">
            <field name="name">mh.booking.tree</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <list string="Bookings"
                    decoration-success="state == 'completed'"
                    decoration-warning="state in ('confirmed', 'in_progress')"
                    decoration-muted="state in ('cancelled', 'no_show')"
                    multi_edit="1"
                    default_order="booking_date_start desc">
                    <field name="name" readonly="1"/>
                    <field name="booking_date_start"/>
                    <field name="partner_id"/>
                    <field name="booking_type_id"/>
                    <field name="zone_id"/>
                    <field name="staff_ids" widget="many2many_tags"/>
                    <field name="job_status" widget="badge"
                        decoration-success="job_status == 'completed'"
                        decoration-warning="job_status in ('scheduled', 'en_route')"
                        decoration-info="job_status == 'in_progress'"
                        decoration-danger="job_status == 'follow_up'"/>
                    <field name="material_flag" widget="boolean_toggle" optional="show"/>
                    <field name="payment_method" optional="show"/>
                    <field name="price_total" sum="Total"/>
                    <field name="state" widget="badge" optional="hide"
                        decoration-success="state == 'completed'"
                        decoration-warning="state in ('confirmed', 'in_progress')"
                        decoration-danger="state == 'cancelled'"
                        decoration-info="state == 'draft'"/>
                    <field name="has_conflicts" optional="hide"/>
                    <field name="user_id" optional="hide"/>
                    <field name="subscription_id" optional="hide"/>
                    <field name="sale_order_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- MH Booking Form View -->
        <record id="view_mh_booking_form" model="ir.ui.view">
            <field name="name">mh.booking.form</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <form string="Booking" class="o_form_container">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_start" string="Start" type="object" invisible="state != 'confirmed'"/>
                        <button name="action_complete" string="Complete" type="object" invisible="state not in ('confirmed', 'in_progress')"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ('completed', 'cancelled', 'no_show')" confirm="Are you sure you want to cancel this booking?"/>
                        <button name="action_mark_no_show" string="No Show" type="object" invisible="state != 'confirmed'"/>
                        <button name="action_send_whatsapp" string="Send WhatsApp" type="object" invisible="state in ('cancelled', 'no_show')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <!-- Tab 1: Main Info -->
                            <page string="Main Info" name="main_info">
                                <group>
                                    <group string="Customer Info">
                                        <field name="partner_id"/>
                                        <field name="contact_id" domain="[('parent_id', '=', partner_id)]"/>
                                        <field name="client_source" widget="selection"/>
                                        <field name="site_address"/>
                                        <field name="gps_coordinates"/>
                                        <field name="maps_link" widget="url" readonly="1"/>
                                    </group>
                                    <group string="Service Details">
                                        <field name="booking_type_id"/>
                                        <field name="service_subcategory"/>
                                        <field name="zone_id"/>
                                        <field name="booking_date"/>
                                        <field name="booking_date_start"/>
                                        <field name="booking_date_end"/>
                                        <field name="duration_display" readonly="1"/>
                                        <field name="buffer_time_minutes"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Staff Assignment">
                                        <field name="staff_ids" widget="many2many_tags"/>
                                        <field name="staff_count" readonly="1"/>
                                        <field name="team_lead_id"/>
                                        <field name="driver_id"/>
                                        <field name="driver_team_id"/>
                                    </group>
                                    <group string="Booking Status &amp; Flags">
                                        <field name="material_flag"/>
                                        <field name="payment_method" />
                                        <field name="payment_collected"/>
                                        <field name="job_status" widget="badge"
                                            decoration-success="job_status == 'completed'"
                                            decoration-warning="job_status in ('scheduled', 'en_route')"
                                            decoration-info="job_status == 'in_progress'"
                                            decoration-danger="job_status == 'follow_up'"/>
                                        <field name="contract_reference"/>
                                    </group>
                                </group>
                                <group string="Pricing">
                                    <group>
                                        <field name="list_price"/>
                                        <field name="tax_ids" widget="many2many_tags"/>
                                    </group>
                                    <group>
                                        <field name="price_subtotal" readonly="1"/>
                                        <field name="price_total" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Project/Task">
                                        <field name="project_id"/>
                                        <field name="task_id"/>
                                    </group>
                                    <group string="Tracking">
                                        <field name="user_id"/>
                                        <field name="company_id"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Tab 2: Notifications -->
                            <page string="Notifications" name="notifications">
                                <group>
                                    <group string="Booking Notifications">
                                        <field name="booking_notification_setting" />
                                        <field name="notify_operations_manager"/>
                                        <field name="grace_period_minutes"/>
                                    </group>
                                    <group string="Completion Notifications">
                                        <field name="completion_notification_setting" />
                                    </group>
                                </group>
                                <group>
                                    <group string="Confirmation Status">
                                        <field name="operations_manager_confirmed" readonly="1"/>
                                        <field name="completion_confirmed" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Tab 3: AMC & Commercial -->
                            <page string="AMC &amp; Commercial" name="amc_commercial">
                                <group>
                                    <group string="AMC Details">
                                        <field name="subscription_id" readonly="1"/>
                                        <field name="is_amc_booking" readonly="1"/>
                                        <field name="contract_hours_start"/>
                                        <field name="contract_hours_end"/>
                                    </group>
                                    <group string="Commercial Details">
                                        <field name="is_commercial" readonly="1"/>
                                        <field name="sale_order_id" readonly="1"/>
                                        <field name="is_one_time_booking" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Tab 4: Completion -->
                            <page string="Completion" name="completion">
                                <group>
                                    <group string="Completion Details">
                                        <field name="completion_date"/>
                                        <field name="completion_notes"/>
                                    </group>
                                    <group string="Customer Feedback">
                                        <field name="customer_feedback"/>
                                        <field name="customer_rating" widget="priority"/>
                                    </group>
                                </group>
                                <group string="Checklist">
                                    <field name="checklist_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="name"/>
                                            <field name="is_done"/>
                                            <field name="staff_id"/>
                                            <field name="completed_date"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <!-- Tab 5: Conflicts & Notes -->
                            <page string="Conflicts &amp; Notes" name="conflicts_notes">
                                <group>
                                    <group string="Conflict Status">
                                        <field name="has_conflicts" readonly="1"/>
                                        <field name="conflict_message"/>
                                        <field name="conflict_line_ids" readonly="1" nolabel="1">
                                            <list string="Conflicts">
                                                <field name="staff_id"/>
                                                <field name="conflict_type"/>
                                                <field name="name"/>
                                            </list>
                                        </field>
                                    </group>
                                </group>
                                <group string="Internal Notes">
                                    <field name="internal_notes"/>
                                </group>
                                <group>
                                    <group string="Calendar Integration">
                                        <field name="calendar_event_id"/>
                                        <field name="google_event_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- MH Booking Calendar View -->
        <record id="view_mh_booking_calendar" model="ir.ui.view">
            <field name="name">mh.booking.calendar</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <calendar string="Bookings"
                    date_start="booking_date_start"
                    date_end="booking_date_end"
                    color="zone_id"
                    quick_add="0"
                    mode="week">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="booking_type_id"/>
                    <field name="staff_ids" widget="many2many_tags"/>
                    <field name="state" invisible="1"/>
                </calendar>
            </field>
        </record>

        <!-- MH Booking Search View -->
        <record id="view_mh_booking_search" model="ir.ui.view">
            <field name="name">mh.booking.search</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <search string="Search Bookings">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="booking_type_id"/>
                    <field name="zone_id"/>
                    <field name="staff_ids"/>
                    <field name="subscription_id"/>
                    <field name="sale_order_id"/>
                    <field name="user_id"/>
                    <separator/>
                    <filter string="My Bookings" name="my_bookings" domain="[('user_id', '=', uid)]"/>
                    <filter string="Today" name="today" domain="[('booking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Week" name="this_week" domain="[('booking_date', '>=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')), ('booking_date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Has Conflicts" name="has_conflicts" domain="[('has_conflicts', '=', True)]"/>
                    <filter string="AMC Bookings" name="amc" domain="[('is_amc_booking', '=', True)]"/>
                    <filter string="One-Time Bookings" name="one_time" domain="[('is_one_time_booking', '=', True)]"/>
                    <separator/>
                    <filter string="Booking Date" name="booking_date" date="booking_date"/>
                    <separator/>
                    <group expand="0" string="Group By" name="group_by">
                        <filter string="Zone" name="zone_id" context="{'group_by': 'zone_id'}"/>
                        <filter string="Booking Type" name="booking_type_id" context="{'group_by': 'booking_type_id'}"/>
                        <filter string="State" name="state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- MH Booking Pivot View -->
        <record id="view_mh_booking_pivot" model="ir.ui.view">
            <field name="name">mh.booking.pivot</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <pivot string="Booking Analysis" sample="1">
                    <field name="booking_date" type="col" string="Date"/>
                    <field name="booking_type_id" type="row"/>
                    <field name="price_total" type="measure"/>
                    <field name="duration" type="measure"/>
                    <field name="staff_count" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- MH Booking Graph View -->
        <record id="view_mh_booking_graph" model="ir.ui.view">
            <field name="name">mh.booking.graph</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <graph string="Booking Graph" type="bar">
                    <field name="booking_date" type="row"/>
                    <field name="price_total" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- MH Booking Kanban View -->
        <record id="view_mh_booking_kanban" model="ir.ui.view">
            <field name="name">mh.booking.kanban</field>
            <field name="model">mh.booking</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="state">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_card_clickable oe_kanban_card_demo">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_kanban_card_header_title">
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                                <div class="o_kanban_card_body">
                                    <field name="booking_date_start"/>
                                    <br/>
                                    <field name="booking_type_id"/>
                                    <br/>
                                    <field name="partner_id"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- MH Booking Action -->
        <record id="action_mh_booking" model="ir.actions.act_window">
            <field name="name">Bookings</field>
            <field name="res_model">mh.booking</field>
            <field name="view_mode">tree,form,calendar,kanban,pivot,graph</field>
            <field name="context">{'search_default_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Booking
                </p>
                <p>Bookings are service appointments scheduled for customers.</p>
            </field>
        </record>

        <!-- MH Booking Quick Create Action -->
        <record id="action_mh_booking_quick_create" model="ir.actions.act_window">
            <field name="name">Quick Booking</field>
            <field name="res_model">mh.booking</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- MH Booking Action - Today's -->
        <record id="action_mh_booking_today" model="ir.actions.act_window">
            <field name="name">Today's Bookings</field>
            <field name="res_model">mh.booking</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="context">{'search_default_booking_date': 1}</field>
        </record>

        <!-- MH Booking Action - Unassigned -->
        <record id="action_mh_booking_unassigned" model="ir.actions.act_window">
            <field name="name">Unassigned Bookings</field>
            <field name="res_model">mh.booking</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="domain">[('staff_ids', '=', False)]</field>
        </record>

        <!-- MH Booking Action - With Conflicts -->
        <record id="action_mh_booking_conflicts" model="ir.actions.act_window">
            <field name="name">Bookings with Conflicts</field>
            <field name="res_model">mh.booking</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="domain">[('has_conflicts', '=', True)]</field>
        </record>

        <!-- MH Booking Completion Wizard Action -->
        <record id="action_mh_booking_completion_wizard" model="ir.actions.act_window">
            <field name="name">Complete Booking</field>
            <field name="res_model">mh.booking.completion.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_mh_booking"
            name="Bookings"
            action="action_mh_booking"
            parent="menu_mh_booking_root"
            sequence="20"/>
    </data>
</odoo>
