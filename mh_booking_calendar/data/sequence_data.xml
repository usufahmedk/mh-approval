<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Booking Sequence -->
        <record id="seq_mh_booking" model="ir.sequence">
            <field name="name">MH Booking Sequence</field>
            <field name="code">mh.booking</field>
            <field name="prefix">BKG/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Staff Leave Sequence -->
        <record id="seq_mh_staff_leave" model="ir.sequence">
            <field name="name">MH Staff Leave Sequence</field>
            <field name="code">mh.staff.leave</field>
            <field name="prefix">LEAVE/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Zone Sequence -->
        <record id="seq_mh_zone" model="ir.sequence">
            <field name="name">MH Zone Sequence</field>
            <field name="code">mh.zone</field>
            <field name="prefix">ZN/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Driver Team Sequence -->
        <record id="seq_mh_driver_team" model="ir.sequence">
            <field name="name">MH Driver Team Sequence</field>
            <field name="code">mh.driver.team</field>
            <field name="prefix">DT/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- AMC Contract Sequence -->
        <record id="seq_sale_subscription_contract" model="ir.sequence">
            <field name="name">AMC Contract Sequence</field>
            <field name="code">sale.subscription.contract</field>
            <field name="prefix">AMC/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>