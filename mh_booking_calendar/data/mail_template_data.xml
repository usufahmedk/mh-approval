<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Booking Confirmation Email -->
        <record id="booking_confirmation_email" model="mail.template">
            <field name="name">MH Booking Confirmation</field>
            <field name="model_id" ref="mh_booking_calendar.model_mh_booking"/>
            <field name="email_from">{{ object.company_id.email or 'noreply@MHTechnical.ae' }}</field>
            <field name="subject">Booking Confirmed - {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear {{ object.partner_id.name }},</p>
                    <p>Your booking has been confirmed!</p>
                    <table style="border-collapse: collapse; margin: 20px 0;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Booking Ref:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Service:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.product_id.name }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Date &amp; Time:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.booking_date_start.strftime('%Y-%m-%d %H:%M') }} -
                                {{ object.booking_date_end.strftime('%H:%M') }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Address:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.site_address or object.partner_id.contact_address }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Assigned To:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.staff_ids[0].name if object.staff_ids else 'TBD' }}</td>
                        </tr>
                    </table>
                    <p>Thank you for choosing M&amp;H Technical Services!</p>
                </div>
            </field>
        </record>

        <!-- Booking Completion Email -->
        <record id="booking_completion_email" model="mail.template">
            <field name="name">MH Booking Completion</field>
            <field name="model_id" ref="mh_booking_calendar.model_mh_booking"/>
            <field name="email_from">{{ object.company_id.email or 'noreply@MHTechnical.ae' }}</field>
            <field name="subject">Service Completed - {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear {{ object.partner_id.name }},</p>
                    <p>Your service has been completed!</p>
                    <table style="border-collapse: collapse; margin: 20px 0;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Booking Ref:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Completed On:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.completion_date.strftime('%Y-%m-%d %H:%M') if object.completion_date else 'Today' }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Service:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.product_id.name }}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Completed By:</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.staff_ids[0].name if object.staff_ids else 'Our Team' }}</td>
                        </tr>
                    </table>
                    <p>We appreciate your trust in M&amp;H Technical Services.</p>
                    <p>For any follow-up, please contact us.</p>
                </div>
            </field>
        </record>

        <!-- Booking Cancellation Email -->
        <record id="booking_cancellation_email" model="mail.template">
            <field name="name">MH Booking Cancellation</field>
            <field name="model_id" ref="mh_booking_calendar.model_mh_booking"/>
            <field name="email_from">{{ object.company_id.email or 'noreply@MHTechnical.ae' }}</field>
            <field name="subject">Booking Cancelled - {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear {{ object.partner_id.name }},</p>
                    <p>Your booking has been cancelled.</p>
                    <p><strong>Booking Ref:</strong> {{ object.name }}</p>
                    <p><strong>Original Date:</strong> {{ object.booking_date_start.strftime('%Y-%m-%d %H:%M') if object.booking_date_start else 'N/A' }}</p>
                    <p>Please contact us if you need to reschedule.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>