<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_users_form_inherit_desality" model="ir.ui.view">
        <field name="name">res.users.form.inherit.desality</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Desality Settings" name="desality_settings">
                    <group>
                        <group>
                            <field name="is_default_lead_assignee"/>
                        </group>
                        <group>
                            <!-- Reserved for future Desality settings -->
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>