<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="project_project_view_form_inherit_desality" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.desality</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="is_snagging_project"/>
                <field name="default_assignee_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>