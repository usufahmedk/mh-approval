<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="project_task_view_form_inherit_desality" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.desality</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            
            <!-- Add smart button for related appointment -->
            <div name="button_box" position="inside">
                <button name="action_view_appointment" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-calendar"
                        invisible="not calendar_event_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">View</span>
                        <span class="o_stat_text">Appointment</span>
                    </div>
                </button>
            </div>
            
            <!-- Add the calendar_event_id field to the form (hidden) -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="calendar_event_id" invisible="1"/>
            </xpath>
            
        </field>
    </record>

</odoo>