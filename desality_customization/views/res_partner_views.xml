<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_partner_form_inherit_desality" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.desality</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_referral_partner"/>
                <field name="referral_commission" invisible="not is_referral_partner"/>
                <field name="ambassador_commission"/>
            </xpath>
        </field>
    </record>

    <!-- Add search view for new fields -->
    <record id="view_partner_filter_inherit_desality" model="ir.ui.view">
        <field name="name">res.partner.filter.inherit.desality</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="referral_commission"/>
                <field name="ambassador_commission"/>
            </xpath>
            <xpath expr="//filter[@name='supplier']" position="after">
                <separator/>
                <filter name="referral_partners" string="Referral Partners" 
                        domain="[('is_referral_partner', '=', True)]"/>
                <filter name="with_referral_commission" string="Has Referral Commission" 
                        domain="[('referral_commission', '>', 0)]"/>
                <filter name="with_ambassador_commission" string="Has Ambassador Commission" 
                        domain="[('ambassador_commission', '>', 0)]"/>
            </xpath>
        </field>
    </record>


</odoo>