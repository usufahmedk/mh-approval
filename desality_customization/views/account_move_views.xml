<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_move_form_inherit_desality" model="ir.ui.view">
        <field name="name">account.move.form.inherit.desality</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="crm_lead_id" 
                       options="{'no_create': true}" 
                       help="CRM Lead linked to this invoice (auto-populated from sales order)"
                       invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>