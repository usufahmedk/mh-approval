<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="calendar_event_view_form_inherit_desality" model="ir.ui.view">
        <field name="name">calendar.event.view.form.inherit.desality</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            
            <!-- Add smart button for snagging tasks -->
            <div name="button_box" position="inside">
                <button name="action_view_tasks" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-tasks"
                        invisible="task_count == 0">
                    <field name="task_count" widget="statinfo" string="Snagging Tasks"/>
                </button>
                
                <button name="action_recreate_tasks" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-refresh"
                        invisible="not tasks_deleted_manually">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Recreate</span>
                        <span class="o_stat_text">Tasks</span>
                    </div>
                </button>
            </div>
            
            <!-- Add hidden field for tasks_deleted_manually and portal user field -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="tasks_deleted_manually" invisible="1"/>
            </xpath>
            
            <!-- Add customer name and portal user fields after description -->
            <xpath expr="//field[@name='description']" position="after">
                <field name="customer_name" 
                       string="Customer Name"/>
                <field name="portal_user_id" 
                       string="Portal User Who Booked"
                       domain="[('share', '=', True)]"
                       options="{'no_create': True}"/>
            </xpath>
            
        </field>
    </record>

</odoo>