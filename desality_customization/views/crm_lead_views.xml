<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="crm_lead_view_form_inherit_desality" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.desality</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Add smart buttons for commission bills and invoices -->
            <div name="button_box" position="inside">
                <button name="action_view_commission_bills" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-file-text-o"
                        invisible="commission_bill_count == 0">
                    <field name="commission_bill_count" widget="statinfo" string="Commission Bills"/>
                </button>
                
                <button name="action_view_invoices" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-file-o">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>
            
            <!-- Make expected revenue readonly when sales orders are confirmed -->
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="readonly">has_confirmed_orders</attribute>
            </xpath>
            
            <!-- Add lost reason description after lost_reason_id -->
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="lost_reason_description" invisible="active"/>
            </xpath>
            
            <!-- Add referral partner and delivery date fields -->
            <xpath expr="//group[1]" position="after">
                <group name="desality_group" string="Desality Information">
                    <group name="commission_info" string="Commission Information">
                        <field name="referral_partner_id" options="{'no_create': true}"/>
                        <field name="referral_commission_percentage" invisible="not referral_partner_id"/>
                        <field name="referral_commission_amount" invisible="not referral_partner_id"/>
                        <field name="referral_bill_number" invisible="not referral_bill_number"/>
                        <field name="referral_bill_paid_amount" invisible="not referral_bill_number"/>
                    </group>
                    <group name="property_info" string="Property Information">
                        <field name="delivery_date"/>
                        <field name="unit_type"/>
                    </group>
                    <group name="hidden_fields" invisible="1">
                        <field name="has_confirmed_orders"/>
                        <field name="invoice_activity_id"/>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>



</odoo>