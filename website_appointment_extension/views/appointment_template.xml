<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="appointment_info" inherit_id="appointment_account_payment.appointment_info">
        <xpath expr="//span[hasclass('o_appointment_details_price')]" position="after">
            <span t-if="appointment_type.price_based_on_sq_ft" class="ms-1"> / sq ft</span>
        </xpath>
    </template>
    
    <template id="appointment_form" inherit_id="appointment.appointment_form">
        <xpath expr="//t[@t-if='appointment_type.allow_guests']" position="before">
            <div t-if="appointment_type.price_based_on_sq_ft" class="row mb-4">
                <label class="col-sm-3 col-form-label fw-normal" for="sq_ft">Square Ft*</label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" name="sq_ft" id="sq_ft" required="1" value="1"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
