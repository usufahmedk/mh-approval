<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to open config -->
    <record id="action_customer_status_config" model="ir.actions.act_window">
        <field name="name">Customer Status Configuration</field>
        <field name="res_model">customer.status.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help">
            <p>Configure customer activity thresholds and follow-up settings.</p>
        </field>
    </record>

    <!-- Menu: Settings > Customer Status > Configuration -->
    <menuitem id="menu_customer_status_config"
              name="Customer Status"
              sequence="99"
              parent="base.menu_custom"/>
    <menuitem id="menu_customer_status_config_items"
              name="Configuration"
              action="action_customer_status_config"
              parent="menu_customer_status_config"
              sequence="1"/>
</odoo>
